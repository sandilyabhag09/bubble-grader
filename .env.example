# Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Must exactly match an Authorized redirect URI in the Google OAuth client.
OAUTH_REDIRECT_URI=http://localhost:8765/oauth/callback
SERVER_PORT=8765

# Local auto-grader (optional): when set to 1, a background poller grades work
# shortly after students turn it in. Grades are stored locally only — never
# auto-released to students. AUTO_GRADE_POLL_SECONDS controls the cadence.
AUTO_GRADE_ON_TURNIN=0
AUTO_GRADE_POLL_SECONDS=60
