# Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Must exactly match an Authorized redirect URI in the Google OAuth client.
OAUTH_REDIRECT_URI=http://localhost:8765/oauth/callback
SERVER_PORT=8765

# Local auto-grader (optional): when set to 1, a background poller grades work
# shortly after students turn it in. Grades are stored locally only — never
# auto-released to students. AUTO_GRADE_POLL_SECONDS controls the cadence.
# (Ignored on Vercel — serverless can't run background threads.)
AUTO_GRADE_ON_TURNIN=0
AUTO_GRADE_POLL_SECONDS=60

# --- Hosted (Vercel) deploys only -------------------------------------------
# Set these as Vercel environment variables; locally they're not needed.
#   DATABASE_URL               same Neon Postgres URL as everywhere else
#   FERNET_KEY                 the SHARED key (must match other installs!)
#   OAUTH_REDIRECT_URI         https://<your-app>.vercel.app/oauth/callback
#                              (also add it to the Google OAuth client)
#   GOOGLE_CLIENT_SECRET_JSON  full contents of secrets/client_secret.json
#                              (the file itself is gitignored, so hosted
#                              deploys read the JSON from this variable)
#   AUTO_GRADE_TOKEN           any long random string; enables the
#                              GET /cron/auto-grade?token=... endpoint that an
#                              external pinger hits every few minutes so new
#                              turn-ins grade themselves (also keeps the
#                              function warm)
